{
  // =========================
  // 🟡 JAVASCRIPT BASICS
  // =========================

  "Const": {
    "prefix": "constt",
    "body": [
      "const ${1:name} = ${2:value};"
    ]
  },

  "Let": {
    "prefix": "lett",
    "body": [
      "let ${1:name} = ${2:value};"
    ]
  },

  "Arrow Function": {
    "prefix": "arrow",
    "body": [
      "const ${1:fn} = (${2:params}) => {",
      "  $3",
      "};"
    ]
  },

  "Async Arrow": {
    "prefix": "asyncfn",
    "body": [
      "const ${1:fn} = async (${2:params}) => {",
      "  try {",
      "    $3",
      "  } catch (error) {",
      "    console.error(error);",
      "  }",
      "};"
    ]
  },

  // =========================
  // 🔵 ARRAY HELPERS
  // =========================

  "Map": {
    "prefix": "mapt",
    "body": [
      "const ${1:result} = ${2:items}.map((${3:item}) => {",
      "  return $4;",
      "});"
    ]
  },

  "Reduce": {
    "prefix": "reducet",
    "body": [
      "const ${1:result} = ${2:items}.reduce((acc, ${3:item}) => {",
      "  return acc + $4;",
      "}, ${5:0});"
    ]
  },

  "ForEach": {
    "prefix": "foreach",
    "body": [
      "${1:items}.forEach((${2:item}) => {",
      "  $3",
      "});"
    ]
  },

  "Find": {
    "prefix": "findt",
    "body": [
      "const ${1:found} = ${2:items}.find((${3:item}) => ${4:condition});"
    ]
  },

  "Filter": {
    "prefix": "filtert",
    "body": [
      "const ${1:filtered} = ${2:items}.filter((${3:item}) => ${4:condition});"
    ]
  },

  "GroupBy reduce": {
    "prefix": "groupby",
    "body": [
      "const ${1:map} = ${2:items}.reduce((acc, ${3:item}) => {",
      "  const key = ${4:item.key};",
      "  acc[key] = (acc[key] || 0) + 1;",
      "  return acc;",
      "}, {});"
    ]
  },

  // =========================
  // 🟣 CLASS / OOP
  // =========================

  "Class": {
    "prefix": "class",
    "body": [
      "export class ${1:ClassName} {",
      "  constructor(${2:service}) {",
      "    this.${2} = ${2};",
      "  }",
      "",
      "  ${3:method}() {",
      "    $4",
      "  }",
      "}"
    ]
  },

  "Service Object pattern": {
    "prefix": "serviceobj",
    "body": [
      "export const ${1:serviceName} = {",
      "  async findAll() {",
      "    return prisma.${2:model}.findMany();",
      "  },",
      "",
      "  async findById(id) {",
      "    return prisma.${2:model}.findUnique({ where: { id } });",
      "  }",
      "};"
    ]
  },

  // =========================
  // ⚛️ REACT HOOKS JS
  // =========================

  "useState": {
    "prefix": "state",
    "body": [
      "const [${1:value}, set${2:Value}] = React.useState(${3:initial});"
    ]
  },

  "useMemo": {
    "prefix": "memo",
    "body": [
      "const ${1:value} = React.useMemo(() => {",
      "  return $2;",
      "}, [$3]);"
    ]
  },

  "useCallback": {
    "prefix": "callback",
    "body": [
      "const ${1:handler} = React.useCallback((${2:params}) => {",
      "  $3",
      "}, [$4]);"
    ]
  },

  "Async useEffect": {
    "prefix": "ueasync",
    "body": [
      "React.useEffect(() => {",
      "  const fetchData = async () => {",
      "    $1",
      "  };",
      "  fetchData();",
      "}, [$2]);"
    ]
  },

  // =========================
  // 🟢 BACKEND HELPERS
  // =========================

  "Try Catch Return": {
    "prefix": "tryr",
    "body": [
      "try {",
      "  $1",
      "  return { code: 200, message: 'Success' };",
      "} catch (error) {",
      "  return { code: 500, message: error.message };",
      "}"
    ]
  },

  "Object Map counter": {
    "prefix": "recordmap",
    "body": [
      "const ${1:map} = {};",
      "",
      "${2:items}.forEach((item) => {",
      "  const key = item.${3:key};",
      "  ${1:map}[key] = (${1:map}[key] || 0) + 1;",
      "});"
    ]
  }
}