{
  "Prisma JS Resolver": {
    "prefix": "prisma-resolver-js",
    "body": [
      "const { PrismaClient } = require('@prisma/client');",
      "const prisma = new PrismaClient();",
      "",
      "const ${1:entity}Resolver = {",
      "  findAll: async () => {",
      "    try {",
      "      return await prisma.${2:entity}.findMany();",
      "    } catch (err) {",
      "      console.error('Error in findAll:', err);",
      "      return [];",
      "    }",
      "  },",
      "",
      "  findById: async (id) => {",
      "    try {",
      "      return await prisma.${2:entity}.findUnique({ where: { id } });",
      "    } catch (err) {",
      "      console.error('Error in findById:', err);",
      "      return null;",
      "    }",
      "  },",
      "",
      "  create: async (data) => {",
      "    try {",
      "      return await prisma.${2:entity}.create({ data });",
      "    } catch (err) {",
      "      console.error('Error in create:', err);",
      "      return null;",
      "    }",
      "  },",
      "",
      "  update: async (id, data) => {",
      "    try {",
      "      return await prisma.${2:entity}.update({ where: { id }, data });",
      "    } catch (err) {",
      "      console.error('Error in update:', err);",
      "      return null;",
      "    }",
      "  },",
      "",
      "  delete: async (id) => {",
      "    try {",
      "      return await prisma.${2:entity}.delete({ where: { id } });",
      "    } catch (err) {",
      "      console.error('Error in delete:', err);",
      "      return null;",
      "    }",
      "  }",
      "};",
      "",
      "module.exports = ${1:entity}Resolver;"
    ],
    "description": "Snippet VSCode : Resolver JS Prisma CRUD pour une table générique"
  }
}
