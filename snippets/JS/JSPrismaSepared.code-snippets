{
  "Prisma JS Resolver Separated": {
    "prefix": "prisma-js-resolver-separated",
    "body": [
      "const { PrismaClient } = require('@prisma/client');",
      "const prisma = new PrismaClient();",
      "",
      "const baseName = '${TM_FILENAME_BASE}';",
      "const entityName = baseName.charAt(0).toUpperCase() + baseName.slice(1);",
      "",
      "exports.findAll${1:${TM_FILENAME_BASE/(^|_)(\\w)/${2:/capitalize}/g}} = async () => {",
      "  try {",
      "    return await prisma[baseName].findMany();",
      "  } catch (err) {",
      "    console.error('Error in findAll' + entityName, err);",
      "    return [];",
      "  }",
      "};",
      "",
      "exports.findById${1:${TM_FILENAME_BASE/(^|_)(\\w)/${2:/capitalize}/g}} = async (id) => {",
      "  try {",
      "    return await prisma[baseName].findUnique({ where: { id } });",
      "  } catch (err) {",
      "    console.error('Error in findById' + entityName, err);",
      "    return null;",
      "  }",
      "};",
      "",
      "exports.create${1:${TM_FILENAME_BASE/(^|_)(\\w)/${2:/capitalize}/g}} = async (data) => {",
      "  try {",
      "    return await prisma[baseName].create({ data });",
      "  } catch (err) {",
      "    console.error('Error in create' + entityName, err);",
      "    return null;",
      "  }",
      "};",
      "",
      "exports.update${1:${TM_FILENAME_BASE/(^|_)(\\w)/${2:/capitalize}/g}} = async (id, data) => {",
      "  try {",
      "    return await prisma[baseName].update({ where: { id }, data });",
      "  } catch (err) {",
      "    console.error('Error in update' + entityName, err);",
      "    return null;",
      "  }",
      "};",
      "",
      "exports.delete${1:${TM_FILENAME_BASE/(^|_)(\\w)/${2:/capitalize}/g}} = async (id) => {",
      "  try {",
      "    return await prisma[baseName].delete({ where: { id } });",
      "  } catch (err) {",
      "    console.error('Error in delete' + entityName, err);",
      "    return null;",
      "  }",
      "};"
    ],
    "description": "Snippet VSCode JS Prisma : resolvers séparés CRUD dynamiques basés sur le nom du fichier"
  }
}
