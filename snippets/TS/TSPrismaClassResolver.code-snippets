{
  "Prisma TS Resolver Class": {
    "prefix": "prisma-resolver-class-ts",
    "body": [
      "import { PrismaClient, ${1:Entity} } from '@prisma/client';",
      "const prisma = new PrismaClient();",
      "",
      "export class ${2:Entity}Resolver {",
      "  async findAll(): Promise<${1:Entity}[]> {",
      "    try {",
      "      return await prisma.${3:entity}.findMany();",
      "    } catch (err) {",
      "      console.error('Error in findAll:', err);",
      "      return [];",
      "    }",
      "  }",
      "",
      "  async findById(id: number): Promise<${1:Entity} | null> {",
      "    try {",
      "      return await prisma.${3:entity}.findUnique({ where: { id } });",
      "    } catch (err) {",
      "      console.error('Error in findById:', err);",
      "      return null;",
      "    }",
      "  }",
      "",
      "  async create(data: Omit<${1:Entity}, 'id' | 'createdAt' | 'updatedAt'>): Promise<${1:Entity} | null> {",
      "    try {",
      "      return await prisma.${3:entity}.create({ data });",
      "    } catch (err) {",
      "      console.error('Error in create:', err);",
      "      return null;",
      "    }",
      "  }",
      "",
      "  async update(id: number, data: Partial<${1:Entity}>): Promise<${1:Entity} | null> {",
      "    try {",
      "      return await prisma.${3:entity}.update({ where: { id }, data });",
      "    } catch (err) {",
      "      console.error('Error in update:', err);",
      "      return null;",
      "    }",
      "  }",
      "",
      "  async delete(id: number): Promise<${1:Entity} | null> {",
      "    try {",
      "      return await prisma.${3:entity}.delete({ where: { id } });",
      "    } catch (err) {",
      "      console.error('Error in delete:', err);",
      "      return null;",
      "    }",
      "  }",
      "}",
      "",
      "// Exemple d'export pour instance unique",
      "// export const userResolver = new UserResolver();"
    ],
    "description": "Snippet VSCode : Resolver TypeScript Prisma CRUD en class pour une table générique"
  },
  "Try Catch with typed Error (TS)": {
    "prefix": "trycatch-ts",
    "body": [
      "try {",
      "  $1",
      "  return { code: 200, message: 'Success' };",
      "} catch (error: unknown) {",
      "  const err: Error = error instanceof Error ? error : new Error('Unknown error');",
      "  return { code: 500, message: err.message };",
      "}"
    ]
  },
  
