{
  "Prisma TS Resolver": {
    "prefix": "prisma-resolver-ts",
    "body": [
      "import { PrismaClient, ${1:Entity} } from '@prisma/client';",
      "const prisma = new PrismaClient();",
      "",
      "export const ${2:entity}Resolver = {",
      "  findAll: async (): Promise<${1:Entity}[]> => {",
      "    try {",
      "      return await prisma.${3:entity}.findMany();",
      "    } catch (err) {",
      "      console.error('Error in findAll:', err);",
      "      return [];",
      "    }",
      "  },",
      "",
      "  findById: async (id: number): Promise<${1:Entity} | null> => {",
      "    try {",
      "      return await prisma.${3:entity}.findUnique({ where: { id } });",
      "    } catch (err) {",
      "      console.error('Error in findById:', err);",
      "      return null;",
      "    }",
      "  },",
      "",
      "  create: async (data: Omit<${1:Entity}, 'id' | 'createdAt' | 'updatedAt'>): Promise<${1:Entity} | null> => {",
      "    try {",
      "      return await prisma.${3:entity}.create({ data });",
      "    } catch (err) {",
      "      console.error('Error in create:', err);",
      "      return null;",
      "    }",
      "  },",
      "",
      "  update: async (id: number, data: Partial<${1:Entity}>): Promise<${1:Entity} | null> => {",
      "    try {",
      "      return await prisma.${3:entity}.update({ where: { id }, data });",
      "    } catch (err) {",
      "      console.error('Error in update:', err);",
      "      return null;",
      "    }",
      "  },",
      "",
      "  delete: async (id: number): Promise<${1:Entity} | null> => {",
      "    try {",
      "      return await prisma.${3:entity}.delete({ where: { id } });",
      "    } catch (err) {",
      "      console.error('Error in delete:', err);",
      "      return null;",
      "    }",
      "  }",
      "};"
    ],
    "description": "Snippet VSCode : Resolver TypeScript Prisma CRUD pour une table générique"
  }
}
